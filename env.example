# AmIHuman Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# Firebase Configuration
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# ============================================
# AWS Configuration
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_TRANSCRIBE_REGION=us-east-1

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Voice Authentication Settings
# ============================================
VOICE_AUTH_MIN_CONFIDENCE=0.8
VOICE_AUTH_MAX_DURATION=30
VOICE_AUTH_BIOMETRIC_THRESHOLD=0.75

# ============================================
# Security Settings
# ============================================
# Add any API keys or secrets here
# API_SECRET_KEY=your-secret-key

# ============================================
# Development Settings
# ============================================
# Set to true to use Firebase emulator
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost:8080

# Enable debug logging
DEBUG=false
LOG_LEVEL=info

# ============================================
# Optional: Third-party Services
# ============================================
# Add any additional service credentials here
# SENDGRID_API_KEY=your-sendgrid-key
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token









