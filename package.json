{
  "name": "amihuman",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "naming:check": "node scripts/monitor-naming-conventions.js",
    "naming:audit": "node audit-naming-conventions.js",
    "naming:dashboard": "node scripts/naming-dashboard.js",
    "pre-commit": "npm run naming:check && npm run lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-connect": "^3.896.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/client-transcribe": "^3.896.0",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.7.0",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^12.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@types/jest": "^30.0.0",
    "@types/react": "19.1.12",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.4.0",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "node scripts/monitor-naming-conventions.js"
    ]
  }
}
