{
  "name": "amihuman",
  "version": "1.0.0",
  "private": true,
  "description": "AM I HUMAN - Social Media Platform with Vault System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "analyze": "ANALYZE=true npm run build",
    "audit": "audit-ci --config audit-ci.json",
    "validate": "npm run lint && npm run type-check && npm run build",
    "validate:full": "npm run lint && npm run type-check && npm run test && npm run build && npm run audit",
    "pre-commit": "npm run validate",
    "error-check": "npm run validate && echo '✅ All validations passed'",
    "quality": "npm run validate:full"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "git add"
    ],
    "*.md": [
      "prettier --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.914.0",
    "@aws-sdk/client-transcribe": "^3.914.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "8.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.23",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "autoprefixer": "10.4.20",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "firebase": "^12.4.0",
    "lint-staged": "^16.2.6",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "firebase-admin": "^13.5.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  }
}
